# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production
PORT=3001
FRONTEND_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/container_marketplace"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu"
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ─── SMS / OTP ─────────────────────────────────────────────────────────────────
# Chọn 1 trong 3 provider:
SMS_PROVIDER=console          # console (dev) | twilio | esms

# --- Twilio (quốc tế, ~$0.008/SMS) ---
# Đăng ký: https://www.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# --- ESMS.vn (Vietnam, ~500đ/SMS, khuyến nghị cho production VN) ---
# Đăng ký: https://esms.vn
ESMS_API_KEY=your_api_key
ESMS_SECRET_KEY=your_secret_key

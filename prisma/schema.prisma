generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SHIPPER
  CARRIER
  ADMIN
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  phone         String?
  phoneVerified Boolean        @default(false)
  zaloId        String?
  passwordHash  String
  role          Role
  name          String
  companyName   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  carrier          Carrier?
  orders           Order[]        @relation("ShipperOrders")
  matchesAsCarrier Match[]        @relation("CarrierMatches")
  notifications    Notification[]
}

model Carrier {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id])
  fleetSize  Int       @default(0)
  rating     Float     @default(0)
  totalTrips Int       @default(0)
  verified   Boolean   @default(false)
  vehicles   Vehicle[]
  matches    Match[]
}

model Vehicle {
  id            String        @id @default(cuid())
  carrierId     String
  carrier       Carrier       @relation(fields: [carrierId], references: [id])
  plateNumber   String        @unique
  containerType ContainerType
  maxWeight     Float
  available     Boolean       @default(true)
}

enum ContainerType {
  TWENTY_FT
  FORTY_FT
  FORTY_HC
}

enum OrderStatus {
  OPEN
  MATCHED
  CONFIRMED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model Order {
  id            String        @id @default(cuid())
  shipperId     String
  shipper       User          @relation("ShipperOrders", fields: [shipperId], references: [id])

  fromLocation  String
  fromLat       Float?
  fromLng       Float?
  toLocation    String
  toLat         Float?
  toLng         Float?

  containerType ContainerType
  weightTon     Float
  cargoType     String
  cargoDesc     String?

  pickupAt      DateTime
  deliverBy     DateTime?

  priceOffer    Float?
  status        OrderStatus   @default(OPEN)

  contactPhone  String
  contactZalo   String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  matches       Match[]
}

enum MatchStatus {
  PENDING
  SHIPPER_CONFIRMED
  CONFIRMED
  REJECTED
  CANCELLED
}

model Match {
  id            String      @id @default(cuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id])

  carrierId     String
  carrier       Carrier     @relation(fields: [carrierId], references: [id])

  // Dùng field riêng để tránh trùng constraint với carrierId
  carrierUserId String
  carrierUser   User        @relation("CarrierMatches", fields: [carrierUserId], references: [id])

  returnOrderId   String?
  estimatedSaving Float?
  priceOffer      Float?
  note            String?

  status      MatchStatus @default(PENDING)
  confirmedAt DateTime?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([orderId, carrierId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  refId     String?
  createdAt DateTime @default(now())
}
